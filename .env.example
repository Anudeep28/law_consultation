DATABASE_URL=postgresql://postgres:password@localhost:5432/law_writer?schema=public
JWT_SECRET=replace_with_a_long_random_secret
# Razorpay settings — set RAZORPAY_ENV=live to switch to the live keys
RAZORPAY_ENV=test
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=replace_with_test_secret
RAZORPAY_KEY_ID_LIVE=rzp_live_xxx
RAZORPAY_KEY_SECRET_LIVE=replace_with_live_secret
# Server-side keys — never exposed to the browser
ELEVENLABS_API_KEY=replace_with_elevenlabs_key
DEEPSEEK_API_KEY=replace_with_deepseek_key
# First production admin — use a unique password of at least 12 characters
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password
# MSG91 OTP credentials from the MSG91 dashboard
MSG91_AUTH_KEY=replace_with_msg91_auth_key
MSG91_TEMPLATE_ID=replace_with_approved_otp_template_id
PORT=3001