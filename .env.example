DATABASE_URL=postgresql://postgres:password@localhost:5432/law_writer?schema=public
JWT_SECRET=replace_with_a_long_random_secret
# Razorpay settings — set RAZORPAY_ENV=live to switch to the live keys
RAZORPAY_ENV=test
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=replace_with_test_secret
RAZORPAY_KEY_ID_LIVE=rzp_live_xxx
RAZORPAY_KEY_SECRET_LIVE=replace_with_live_secret
# Server-side keys — never exposed to the browser
ELEVENLABS_API_KEY=replace_with_elevenlabs_key
DEEPSEEK_API_KEY=replace_with_deepseek_key
PORT=3001