DATABASE_URL=postgresql://postgres:password@localhost:5432/law_writer?schema=public
JWT_SECRET=replace_with_a_long_random_secret
# Razorpay settings — set RAZORPAY_ENV=live to switch to the live keys
RAZORPAY_ENV=test
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=replace_with_test_secret
RAZORPAY_KEY_ID_LIVE=rzp_live_xxx
RAZORPAY_KEY_SECRET_LIVE=replace_with_live_secret
# Webhook secret from Razorpay Dashboard → Settings → Webhooks (for /api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret
# Server-side keys — never exposed to the browser
ELEVENLABS_API_KEY=replace_with_elevenlabs_key
DEEPSEEK_API_KEY=replace_with_deepseek_key
# Resend email — get an API key at https://resend.com (free tier: 100 emails/day)
# Use your verified domain address in production. For testing you can use onboarding@resend.dev.
RESEND_API_KEY=replace_with_resend_key
FROM_EMAIL=notifications@lawwriter.app
# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT=mailto:admin@lawwriter.app
# First production admin — use a unique password of at least 12 characters
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password
# MSG91 OTP credentials from the MSG91 dashboard
MSG91_AUTH_KEY=replace_with_msg91_auth_key
MSG91_TEMPLATE_ID=replace_with_approved_otp_template_id
PORT=3002
APP_URL=http://localhost:3000
# Vite embeds REACT_APP_* values in browser bundles at build time. Never put secrets here.
REACT_APP_SUPPORT_EMAIL=support@lawwriter.app
# JSON application/request logging: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=info
# Optional error monitoring. Leave empty to disable; never put private Sentry keys here.
SENTRY_DSN=
# Public browser DSN, embedded at build time. Set the same value on Express for CSP.
REACT_APP_SENTRY_DSN=
# Optional JaaS private call rooms. Configure all three together; never expose these to Vite/browser env.
JAAS_APP_ID=
# Full API key ID (kid), including the app ID prefix shown in the JaaS console
JAAS_API_KEY_ID=
# PEM private key; real newlines and literal \n-escaped newlines are supported
JAAS_PRIVATE_KEY=