generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  TRIAL
  SINGLE
  MONTHLY
  CONSULTATION
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

enum ConsultationStatus {
  PENDING_PAYMENT
  BOOKED
  CANCELLED
  COMPLETED
}

enum ConsultationMode {
  CHAT
  CALL
}

enum ConsultationPackage {
  CALL_ONLY
  CALL_WITH_DOCUMENT
}

enum MessageSender {
  USER
  LAWYER
  SYSTEM
}

enum DeliverableStatus {
  DRAFT
  DELIVERED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationType {
  CONSULTATION_REMINDER
  CONSULTATION_BOOKED
  CHAT_MESSAGE
  DELIVERABLE_READY
}

enum UserRole {
  CLIENT
  LAWYER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum LawyerApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  name               String
  passwordHash       String
  phone              String?          @unique
  phoneVerifiedAt    DateTime?
  role               UserRole         @default(CLIENT)
  accountStatus      AccountStatus     @default(ACTIVE)
  statusReason       String?
  statusChangedAt    DateTime?
  lawyerProfile      Lawyer?
  subscriptionPlan   SubscriptionPlan @default(TRIAL)
  subscriptionExpiry DateTime?
  documentCredits    Int              @default(0)
  emailNotifications Boolean          @default(true)
  pushNotifications  Boolean          @default(true)
  emailVerifiedAt    DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  payments           Payment[]
  documents          Document[]
  consultations      Consultation[]
  reviews            LawyerReview[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  emailVerificationToken EmailVerificationToken?
  adminActions       AdminAuditLog[]  @relation("AdminActor")
  accountAuditLogs   AdminAuditLog[]  @relation("AuditTarget")
}

model Lawyer {
  id                String         @id @default(cuid())
  userId            String?        @unique
  user              User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug              String         @unique
  name              String
  title             String
  bio               String
  practiceAreas     String[]
  languages         String[]
  experienceYears   Int
  barCouncil        String
  enrollmentNumber  String         @unique
  fee                Int
  documentFeePercent Int            @default(50)
  rating             Float
  reviewCount        Int
  isVerified         Boolean                 @default(false)
  approvalStatus     LawyerApprovalStatus    @default(DRAFT)
  rejectionReason    String?
  avatarUrl          String?
  availability       Json
  consultations      Consultation[]
  reviews            LawyerReview[]
}

model ConsultationMessage {
  id              String        @id @default(cuid())
  consultationId  String
  sender          MessageSender
  content         String
  createdAt       DateTime      @default(now())
  consultation    Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, createdAt])
}

model Consultation {
  id          String             @id @default(cuid())
  userId      String
  lawyerId    String
  startsAt    DateTime
  endsAt      DateTime
  topic       String
  notes       String
  mode        ConsultationMode   @default(CHAT)
  package     ConsultationPackage @default(CALL_ONLY)
  status                  ConsultationStatus @default(BOOKED)
  meetingUrl              String?
  transcript              String?
  reminder10MinSentAt     DateTime?
  reminder24HourSentAt    DateTime?
  messages                ConsultationMessage[]
  deliverables            Deliverable[]
  notifications           Notification[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lawyer                  Lawyer             @relation(fields: [lawyerId], references: [id])
  payment                 Payment?
  review                  LawyerReview?

  @@unique([lawyerId, startsAt])
  @@index([userId, startsAt])
}

model Notification {
  id              String                @id @default(cuid())
  userId          String
  consultationId  String?
  type            NotificationType
  channels        NotificationChannel[]
  title           String
  body            String
  data            Json?
  read            Boolean               @default(false)
  createdAt       DateTime              @default(now())
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultation    Consultation?         @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([consultationId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model LawyerReview {
  id             String       @id @default(cuid())
  consultationId String       @unique
  lawyerId       String
  userId         String
  rating         Int
  comment        String?
  isVisible      Boolean      @default(true)
  moderationReason String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  lawyer         Lawyer       @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lawyerId, isVisible, createdAt])
  @@index([userId])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  targetUserId String
  action       String
  reason       String
  createdAt    DateTime @default(now())
  admin        User     @relation("AdminActor", fields: [adminId], references: [id])
  targetUser   User     @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([targetUserId, createdAt])
  @@index([adminId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  plan              SubscriptionPlan
  amount            Int
  status            PaymentStatus @default(CREATED)
  consultationId    String?       @unique
  consultation      Consultation? @relation(fields: [consultationId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  title      String
  content    String   @default("")
  templateId String?
  category   String?
  language   String?  @default("en")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliverable Deliverable?

  @@index([userId, updatedAt])
}

model Deliverable {
  id             String            @id @default(cuid())
  consultationId String
  documentId     String?           @unique
  title          String
  content        String            @default("")
  status         DeliverableStatus @default(DRAFT)
  deliveredAt    DateTime?
  createdAt      DateTime          @default(now())
  consultation   Consultation      @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  document       Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([consultationId])
}
