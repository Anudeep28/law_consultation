generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  TRIAL
  SINGLE
  MONTHLY
  CONSULTATION
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

enum ConsultationStatus {
  PENDING_PAYMENT
  BOOKED
  CANCELLED
  COMPLETED
}

enum ConsultationMode {
  CHAT
  CALL
}

enum ConsultationPackage {
  CALL_ONLY
  CALL_WITH_DOCUMENT
}

enum MessageSender {
  USER
  LAWYER
  SYSTEM
}

enum DeliverableStatus {
  DRAFT
  DELIVERED
}

enum UserRole {
  CLIENT
  LAWYER
  ADMIN
}

enum LawyerApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  name               String
  passwordHash       String
  role               UserRole         @default(CLIENT)
  lawyerProfile      Lawyer?
  subscriptionPlan   SubscriptionPlan @default(TRIAL)
  subscriptionExpiry DateTime?
  documentCredits    Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  payments           Payment[]
  documents          Document[]
  consultations      Consultation[]
}

model Lawyer {
  id                String         @id @default(cuid())
  userId            String?        @unique
  user              User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug              String         @unique
  name              String
  title             String
  bio               String
  practiceAreas     String[]
  languages         String[]
  experienceYears   Int
  barCouncil        String
  enrollmentNumber  String         @unique
  fee                Int
  documentFeePercent Int            @default(50)
  rating             Float
  reviewCount        Int
  isVerified         Boolean                 @default(false)
  approvalStatus     LawyerApprovalStatus    @default(DRAFT)
  rejectionReason    String?
  avatarUrl          String?
  availability       Json
  consultations      Consultation[]
}

model ConsultationMessage {
  id              String        @id @default(cuid())
  consultationId  String
  sender          MessageSender
  content         String
  createdAt       DateTime      @default(now())
  consultation    Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, createdAt])
}

model Consultation {
  id          String             @id @default(cuid())
  userId      String
  lawyerId    String
  startsAt    DateTime
  endsAt      DateTime
  topic       String
  notes       String
  mode        ConsultationMode   @default(CHAT)
  package     ConsultationPackage @default(CALL_ONLY)
  status      ConsultationStatus @default(BOOKED)
  meetingUrl  String?
  transcript  String?
  messages    ConsultationMessage[]
  deliverables Deliverable[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lawyer      Lawyer             @relation(fields: [lawyerId], references: [id])
  payment     Payment?

  @@unique([lawyerId, startsAt])
  @@index([userId, startsAt])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  plan              SubscriptionPlan
  amount            Int
  status            PaymentStatus @default(CREATED)
  consultationId    String?       @unique
  consultation      Consultation? @relation(fields: [consultationId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  title      String
  content    String   @default("")
  templateId String?
  category   String?
  language   String?  @default("en")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliverable Deliverable?

  @@index([userId, updatedAt])
}

model Deliverable {
  id             String            @id @default(cuid())
  consultationId String
  documentId     String?           @unique
  title          String
  content        String            @default("")
  status         DeliverableStatus @default(DRAFT)
  deliveredAt    DateTime?
  createdAt      DateTime          @default(now())
  consultation   Consultation      @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  document       Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([consultationId])
}
